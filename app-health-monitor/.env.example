# Copie para .env e troque TODOS os valores. Nunca commite o .env.
# Use apenas letras e números nas senhas (elas entram numa URL de conexão).

MONGO_DB=healthmonitor
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=troque_esta_senha
MONGO_APP_USER=monitor
MONGO_APP_PASSWORD=troque_esta_senha_tambem

# Gere com: openssl rand -hex 32
API_KEY=troque_por_uma_chave_longa_e_aleatoria

CHECK_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=5
FAILURE_THRESHOLD=3
RETENTION_DAYS=7
MAX_WORKERS=10
ALLOW_PRIVATE_TARGETS=false

# Alertas por email (se SMTP_HOST ficar vazio, o alerta só vai para o log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_TO=
